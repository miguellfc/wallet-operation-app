{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "local-apk": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "local"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "remote-apk": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "remote"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
